DB_PATH=./data/fader.sqlite

# Encrypts the Discogs tokens collectors save in Settings: 32 random bytes, base64 (openssl rand -base64 32).
# Without it the server refuses to store tokens. Losing or changing it makes stored tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# Firebase Admin SDK service account (Project Settings -> Service Accounts -> Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Comma-separated list of emails allowed to authenticate
ALLOWED_EMAILS=
