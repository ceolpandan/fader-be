{
  "name": "fader-be",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p . && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node --transpile-only scripts/migrate.ts",
    "db:import": "ts-node --transpile-only scripts/import-dump.ts",
    "db:requeue-have-want": "ts-node --transpile-only scripts/requeue-have-want.ts",
    "docs:db": "ts-node --transpile-only scripts/generate-dbml.ts",
    "docs:deps": "depcruise src --config .dependency-cruiser.cjs --exclude \"^(node_modules|crypto|fs|os|path|zlib|string_decoder|src/discogs-client.test)\" --collapse \"^src/[^/]+\" --output-type mermaid > docs/architecture/modules.mmd",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "docs:db:svg": "dbml-renderer -i docs/architecture/schema.dbml -o docs/architecture/schema.svg"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "js-yaml": "^5.3.0",
    "saxes": "^6.0.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@softwaretechnik/dbml-renderer": "^1.0.31",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "dependency-cruiser": "^18.6.0",
    "drizzle-dbml-generator": "^0.10.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.0",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
